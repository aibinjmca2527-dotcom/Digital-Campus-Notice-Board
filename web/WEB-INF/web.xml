<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>College Notice Board Management System</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================ -->
    <!--  STUDENT SERVLETS                                            -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SubmitNoticeServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.SubmitNoticeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SubmitNoticeServlet</servlet-name>
        <url-pattern>/submitNotice</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewNoticesServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.ViewNoticesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewNoticesServlet</servlet-name>
        <url-pattern>/viewNotices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.UpdateProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateProfileServlet</servlet-name>
        <url-pattern>/updateProfile</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!--  ADMIN SERVLETS                                              -->
    <!-- ============================================================ -->

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/adminLogin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/adminDashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManageNoticesServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.ManageNoticesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageNoticesServlet</servlet-name>
        <url-pattern>/manageNotices</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManageUsersServlet</servlet-name>
        <servlet-class>com.noticeboard.servlet.ManageUsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageUsersServlet</servlet-name>
        <url-pattern>/manageUsers</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
